    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.lst",
     "lines": "38-40"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "does",
     "of": "doc",
     "text": "Op code C7, RST 0, calls address 0000h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "3269",
       "sha": "998f65dc6d18bd5cfaf758bea04c5243c8ad414e5af0a5f267109b4ae92f017b"
      }
     ]
    },
    {
     "n": "2",
     "on": "does",
     "of": "doc",
     "text": "RST pushes the Program Counter on the stack: SP is decremented and the high-order byte stored, then SP is decremented again and the low-order byte stored.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8608",
       "sha": "45929b1e07d20b7bcdacdb22506ec26991db80960db9edb517ba234623fc02e0"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8614",
       "sha": "086f1f6a8238bf5c42beed8c352bac10e9e0d3b2b8af4e4e1fec7179a0e81fd6"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8616-8619",
       "sha": "5faea1770287322fcf79ba27134765918d520f325956f731d661715279c5d80d"
      }
     ]
    },
    {
     "n": "3",
     "on": "does",
     "of": "doc",
     "text": "RST 00h loads the Program Counter with 0000h: the high-order byte is 00h and the low-order byte is the p value 00h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8608",
       "sha": "45929b1e07d20b7bcdacdb22506ec26991db80960db9edb517ba234623fc02e0"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8615",
       "sha": "0ec474018234005be59e9c8d023df297ecf357243d843315d75871fba7f08ea0"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8622-8624",
       "sha": "8f3ae8f566014a4ea6346672e4262c0f6dc4593053fc666dd7575322e9dedadb"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8626",
       "sha": "4edc61bbd4d92a7bcf875df10efda79f5c69e9c7a09d2b6dac0a56846a6c6867"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Program execution then begins with the op code at the address now pointed to by the Program Counter.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8615-8616",
       "sha": "a28799c60d40c6ff3419b20cfe3efa96aa4c5fa2da09856957b59031f14883f7"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The Restart instruction allows a jump to one of eight addresses, indicated in the table that follows.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8619-8620",
       "sha": "9128e2abd91cf3d49d035c583c72127522252655cba73c1d7ccd759d6560cfdb"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "RESET clears the Program Counter.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "701-702",
       "sha": "0d7945f6b733df0ed9f1996b4faeff7c0bb11e0512da417ed2a6040c9955f0c7"
      }
     ]
    },
    {
     "n": "7",
     "on": "when",
     "of": "doc",
     "text": "RESET resets the interrupt enable flip-flop.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "701-702",
       "sha": "0d7945f6b733df0ed9f1996b4faeff7c0bb11e0512da417ed2a6040c9955f0c7"
      }
     ]
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "RESET clears registers I and R.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "702",
       "sha": "ea18e56963a092c75e231fd1a0952d835282fb7f3ee151d8ef20d351c541b1c2"
      }
     ]
    },
    {
     "n": "9",
     "on": "when",
     "of": "doc",
     "text": "RESET sets the interrupt status to Mode 0.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "702-703",
       "sha": "36461923b4af8df5e642d358a7e0dce0a6758ef37ca78654ad91a3ec04d4f049"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "The operand p is assembled into the op code using the corresponding t value; in the table of p and t values, 00h is paired with 000.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8620-8621",
       "sha": "c6e5efabdb7ea8963f309c9a3240dec3e46ae0598469097f637e17bdf4d0d0ec"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8625-8626",
       "sha": "0b83917e41ad058e4941181f5f8c00b0e4540e5be05ac63507474426ef4f2e71"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "device_reset stores nothing to the interrupt mode, so the mode set before the reset stays; device_start stores 0 to it.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "761-772",
       "sha": "7926e664f9766c2c49164d6460b622bb0d5df4ec34ee737f44d759cfeac05d3c"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "773-777",
       "sha": "8c965280c48042e183881ed9866ddff304da61a40d6e2265112f5fac6a9340da"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "643",
       "sha": "e6b0ea398c19dc6b82293b0a344143d27c814069345d42dfe49841c72aa12959"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "704",
       "sha": "487a2cdfb41fe17b3a1144c797dc41251ec07c046430fa944ffca630faa077a7"
      }
     ],
     "row": "9"
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "device_reset also calls leave_halt, sets WZ to PC, stores 0xffff00 in m_ref, and calls set_service_attention with 0 for the NMI-pending, after-EI and after-LD A,I flags.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "763",
       "sha": "4fa65fbce7986ef3bc64887dd3002e1a4e8fe84f8c1311567fb3f8d10584d1e9"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "765",
       "sha": "abd1eff73714a1f5972782a95dd03ce82b596c271052d09129279104b254b279"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "767",
       "sha": "a592e9eaf5e2d6e9052fba74df0ecc48e0af221761e07d513d0f26aef9df1167"
      },
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "774-776",
       "sha": "02276b8d8e35683d6253c5a6832162e7eba48c26b8bcbd8c453daab618d89d5e"
      }
     ]
    },
    {
     "n": "103",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "Op code C7 is the list entry that runs the rst macro with address 0x00.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.lst",
       "lines": "6894-6895",
       "sha": "88b919f6b25d6d1f8d771036178e9b798269341007efcbdc3324faf937c31c5a"
      }
     ]
    },
    {
     "n": "104",
     "on": "does",
     "of": "mame",
     "vs": "extra",
     "text": "The rst macro also copies the new Program Counter into WZ.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.lst",
       "lines": "290",
       "sha": "a592e9eaf5e2d6e9052fba74df0ecc48e0af221761e07d513d0f26aef9df1167"
      }
     ]
    }
   ],
