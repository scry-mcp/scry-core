   "rows": [
    {
     "n": "1",
     "on": "does",
     "of": "doc",
     "text": "Op code FF, RST 56, calls address 0038h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "3276",
       "sha": "8141ad29e25c5954d2e2c49ce0b5c1958754171fab02f61c845d80a617bb4d4c"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "In the table of p and t values, 38h is paired with 111.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "8633",
       "sha": "4616c417e35fa20277caa3eabdced5e1bd980334cb2d8e5604df9bd9d03aadfc"
      }
     ],
     "links": [
      "z80:vector:0x00"
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "In interrupt mode 1 the CPU responds to an interrupt by executing a restart at address 0038h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1101-1102",
       "sha": "6f51466cba53229124cc871f38f0e41cffa7f0a88cf179b16b6ab81e6160eca9"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The mode 1 response is identical to that of a nonmaskable interrupt except that the call location is 0038h instead of 0066h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1102-1103",
       "sha": "927de266d6de48e20b6151e0bcb7fb56e0fbb05e21d8a0d33cb563cf2e3505c4"
      }
     ],
     "links": [
      "z80:vector:0x66"
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "Accepting a maskable interrupt resets both IFF1 and IFF2; the manual says this inhibits further interrupts until the programmer issues a new EI.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1046-1048",
       "sha": "49abda7d20e13ee4f70de2ef91b8134a5a7c0dde49cf1c973f0c538cc78dfc3a"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The EI instruction sets both IFF1 and IFF2 to the enable state.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1046",
       "sha": "f0450db3cafd9639d25bf24cc55be63a31319833c823d925c8d422a49e5e7a95"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "Op code FF is the list entry that runs the rst macro with address 0x38.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.lst",
       "lines": "7092-7093",
       "sha": "1e039a6427964618da7756712627acee2ea3d22fdf89f61b6865de121c89a24b"
      }
     ]
    },
    {
     "n": "102",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "check_interrupts runs take_interrupt when the INT line is asserted, IFF1 is set and the after-EI flag is clear.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.lst",
       "lines": "1021-1022",
       "sha": "fda469cdad700147914a8cef21fa4080c1dc3dd8ba7abf32a9e29071ca253981"
      }
     ]
    }
   ],
