    },
    {
     "ref": "datasheet:z80cpu_um.raw.txt",
     "lines": "1051-1052"
    },
    {
     "ref": "datasheet:z80cpu_um.raw.txt",
     "lines": "1080-1084"
    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.cpp",
     "function": "z80_device::execute_set_input",
     "case": [
      "INPUT_LINE_NMI"
     ]
    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.lst",
     "lines": "890-902"
    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.lst",
     "lines": "1018-1023"
    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.lst",
     "lines": "43-45"
    },
    {
     "ref": "mame:src/devices/cpu/z80/z80.lst",
     "lines": "38-40"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "NMI is the Nonmaskable Interrupt input.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "694",
       "sha": "45f8aee51ce194cd98aa1bfa00620899eb4c7640186f8e1bf85fa52b04ff0530"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "The NMI input is negative edge-triggered.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "694",
       "sha": "45f8aee51ce194cd98aa1bfa00620899eb4c7640186f8e1bf85fa52b04ff0530"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "NMI has a higher priority than INT.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "694-695",
       "sha": "de0fbabf991dc36c07f4e5da434620a262725a0292d8dbfcb50833e4d709f75f"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "NMI is accepted regardless of the status of the interrupt enable flip-flop.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "695-696",
       "sha": "6a19a621ebba3aeba6932a4d655693745ae0c8e53144e874f8a8b10fb143dc77"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1080",
       "sha": "bbba0647293cb3fb664127f61fce6ce677e67aa4dd60f2a9a3dec68bded7d7eb"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "An accepted NMI makes the CPU restart at address 0066h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "696-697",
       "sha": "5f738e75508161a736d23b3bcd27a984860d5f9df05bdc424ef7ff0df9e203b6"
      },
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1081-1082",
       "sha": "e8cd40e75c9e5c7ad83d265aed9c0187db33881fa56989bf705389be5a654563"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The NMI restart is like a restart instruction to a location outside the eight software restart locations; a restart is a call to an address in Page 0.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1082-1084",
       "sha": "2f9ccdcd1d9b86606dc4741a3cb3d723dcc29f1ec3bad6890f37c1291ffcd0fb"
      }
     ]
    },
    {
     "n": "7",
     "on": "does",
     "of": "doc",
     "text": "The NMI response stores the Program Counter in the external stack and jumps to address 0066h.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "905-906",
       "sha": "b165d2f2dd8f44e1f1f6de5a35bb03d53accdd30e1dfb1cffb1084dc034d77b5"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "The service routine for the nonmaskable interrupt must begin at address 0066h if this interrupt is used.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "906-908",
       "sha": "b0dca0b760eb4bbb5074d31c264a5b599d5c4dee6a19cb5642528a2b6ed986f8"
      }
     ]
    },
    {
     "n": "9",
     "on": "does",
     "of": "doc",
     "text": "Accepting an NMI resets IFF1; the manual says this prevents further interrupts until the programmer re-enables them.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "1051-1052",
       "sha": "58080e667903967d8b2d12685b07d896495d3a47435e14e54290b53947e0a256"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "The CPU response to an NMI is similar to a normal memory read; the contents of the data bus are ignored.",
     "quotes": [
      {
       "ref": "datasheet:z80cpu_um.raw.txt",
       "lines": "904-905",
       "sha": "7b5291eb6d0b3064a5f842406df8f2439b8f3e1839a0cd18144f0121b59fa6f4"
      }
     ]
    },
    {
     "n": "111",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "MAME marks an NMI pending when the line goes from clear to asserted, but only if total_cycles() is not zero.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/z80/z80.cpp",
       "lines": "798-801",
       "sha": "f2051160f3ad275185771612f2583c63a8f7e9fa820df32fb4801fc622d30dd6"
      }
     ],
     "row": "2"
    },
    {
     "n": "112",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "check_interrupts runs take_nmi when the NMI-pending flag is set.",
     "quotes": [
