  {
   "key": "0x66",
   "name": "NMI",
   "aliases": [
    "non-maskable interrupt"
   ],
   "regions": [
    {
     "ref": "datasheet:z80cpu_um.raw.txt",
     "lines": "694-697"
    },
    {
     "ref": "datasheet:z80cpu_um.raw.txt",
