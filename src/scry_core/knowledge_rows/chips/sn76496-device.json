     "row": "7"
    },
    {
     "n": "102",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "DOSBox-X initialises at device start; its SN76496 is constructed with the Sega flag set, so the last selected register starts at 0x03.",
