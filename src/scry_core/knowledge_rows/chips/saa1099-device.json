   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The SAA1099 is a write-only bus structure: the data bus takes a register address and then its data.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "339-341",
       "sha": "74f60178549ac93ec8be0f41b731c0d5c3ee57ef18235be84075b312d6572847"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "A0 selects control data when 0 and the address buffer when 1, as the register maps show.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "342-343",
       "sha": "e553b8aa27bddeea8cd2aaa9f3b80f9ec2d873f07b44cd51d54d37f0fc77843a"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "366-371",
       "sha": "54e43416673cbcd80d18f6d2904368ab4b5b372a626f0a26d9a9e40b71d04094"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "WR and CS control the transfer and DTACK acknowledges the completed cycle.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "121-122",
       "sha": "aeb2e65911288721ac941a8a04128e946923b3be00ca9643a16cc07453eb5114"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "344-346",
       "sha": "a0a8765ca6fb36c3418c0698f6cdc5b37c174782ec9b8405a9b74d43175e1b2f"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The clock input is externally generated at a nominal frequency of 8 MHz.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "123-124",
       "sha": "5845d5872a2439bff5caa46affe702da3c3fdd7e17a5021f6dace39ae291eb38"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Pulse width modulation sets the amplitude and envelope levels at a minimum rate of 62,5 kHz.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "333-336",
       "sha": "54af154bd5f9f3c12c3f31faba5ac8e3dcf42eabe7da2e2eb84c497432817eb1"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Rates quoted are for an 8 MHz clock, and an amplitude load may need wait cycles before DTACK.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "337-338",
       "sha": "6efde5830c7774e8078b09d258703a00318c7489a5ce8208acb8639410535481"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "346-349",
       "sha": "93adfa572fadbf7534b339109e38fe5e2acd380e38caacde329b9d00558a749c"
      }
     ]
    },
    {
     "n": "6",
     "on": "reset",
     "of": "doc",
     "text": "The sound enable is reset to 0 at power-up, so all channels start disabled.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
