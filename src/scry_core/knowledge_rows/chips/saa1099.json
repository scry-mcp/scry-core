    },
    {
     "ref": "dosbox-x:src/hardware/mame/saa1099.cpp",
     "lines": "399-403"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Registers 00 to 05 hold the amplitude of channels 0 to 5: right in D7-D4 and left in D3-D0.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "377-384",
       "sha": "4d20fe224740a5823903c5a3d53b9212b28a91b528ec1f43d8ee1be10d21ccd8"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "ARn3 to ARn0 are the right channel's four amplitude bits and ALn3 to ALn0 the left's.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "420-425",
       "sha": "08f2861543b92b4b0eec28d4842995cee0699d9b412c875ea6707e198dc441d4"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "0000 is the minimum amplitude (off) and 1111 the maximum.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "422-423",
       "sha": "14b2de6867e3ed8f85de741e00dbb958494a90db4b71e3477527e176dea6edf9"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "426-427",
       "sha": "24b8d8018813ffccc92c02446733157fc3eda3df76089512ca699bbd5d7139e4"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Each channel output splits into a right and a left component: twelve amplitude controllers of sixteen levels.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "167-172",
       "sha": "ffbf4015b2cfd2abe68a52293b049d34cea30cc58a76b953c9356aa7d3067e0d"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Under an envelope generator the level is reduced to eight by disabling the least significant bit.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "173-175",
       "sha": "99da7b0c2d50db5dd58341bb7e622981d4d0b37b0fdaae454c9b3b904d242300"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "A write to a register 00 to 05 sets both amplitude components of that channel in one byte.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "378-384",
       "sha": "399c205d0917122913cbe1fa65bc84741b262890dea9891780a17596f838cdcc"
      }
     ]
    }
   ],
   "closed": [
