     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 14 switches the six frequency generators on and off, one bit per channel (FE5 to FE0).",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "399",
       "sha": "7a2743538bafe09f9a4c0387d8d1643555b5bd1e52f5991dd25bfe9c5f3876c0"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "441",
       "sha": "583c488cd806de75034d1195847afd4839afb329270699a33cbec01eeb523ecb"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "FEn = 0 turns frequency n off for that generator.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "442",
       "sha": "aa6c88fb6fc35fc729bda80f72a1852ccba8b894945e28f5c9392330ba325440"
