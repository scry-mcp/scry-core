   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 1C holds the RST and SE bits.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "408",
       "sha": "de11f5de6cbc5a2e4bfa28c67912e44367116a56ff18564823ad1ff352522302"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "SE enables all channels: 0 disables them and 1 enables them, reset to 0 on power-up.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "487-490",
       "sha": "47bfca591bffcb47f9e0a98bf7b99a5fb1e17ea59649b0c39b71b805cfef6169"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "RST resets and synchronises all frequency generators: 0 enables them, 1 resets them.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "491-493",
       "sha": "6fbe9f6ef9afee96a9563d34981860e368d49a11e91459e9e05125b85a97c04e"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write to register 1C sets the sound enable and the reset bits together.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "408",
       "sha": "de11f5de6cbc5a2e4bfa28c67912e44367116a56ff18564823ad1ff352522302"
      }
     ]
    }
   ],
