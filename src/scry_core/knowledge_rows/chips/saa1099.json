    {
     "ref": "dosbox-x:src/hardware/mame/saa1099.cpp",
     "lines": "410-414"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Registers 10 to 12 hold two octaves each, labelled O12-O10 for one and O02-O00 for the other on the capture line.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "395-397",
       "sha": "a42a1444d7799b57f61ef4f6212353c993d9e28480dc189367ff1a61aae3f540"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "O2 to O0 select one of eight octaves, from 31 Hz to 61 Hz up to 3,91 kHz to 7,81 kHz.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "432-440",
       "sha": "bb1dc97acf5b92d5469d581ec59e80caf1d9368fa137a4b8412e951884d17a28"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The document lists the frequency range of each of the eight octaves.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "138-147",
       "sha": "ecd71be39b5b42bcc6e22a321d2cb231ff83d092ae5f271a45de3939312c0503"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write to a register 10 to 12 sets the octave bits of both channels of the pair.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "395-397",
       "sha": "a42a1444d7799b57f61ef4f6212353c993d9e28480dc189367ff1a61aae3f540"
      }
     ]
    }
   ],
