     "lines": "425-432"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 15 switches noise on for the six channels, one bit per channel (NE5 to NE0).",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "400",
       "sha": "f3f64b6834a671c8cdea6d13112de9e9d986b9ac491e7192b527075f21bf12fb"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "443",
       "sha": "123ce993eb4f021af25fd3fc6866d36228a190b6fbab9f696f836e8b5ee10291"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The six mixers offer channel off, frequency only, noise only, and noise and frequency.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "159-164",
       "sha": "615448e36dca3073829efc84eaa9c7ef327fa2397d871a61de34654673584c62"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Three of the mixer channels use noise generator 0 and the other three use noise generator 1.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "165-166",
       "sha": "1e757ba0fd3da9f726a6c3413f6ff2bc952747906cc1738739abf781186488bc"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "NEn = 0 turns noise n off for that channel.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "444",
       "sha": "293d753a6c45c60bb031f5ffefe155f6fa9df1bd35f1c7b1c3573cbc31ce000a"
      }
     ]
    }
   ],
