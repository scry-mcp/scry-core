    {
     "ref": "dosbox-x:src/hardware/mame/saa1099.cpp",
     "lines": "405-408"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Registers 08 to 0D hold the frequency of tones 0 to 5, eight bits F7 to F0.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "387-392",
       "sha": "7c5525a3df30add3449c462896b4d3131de045dedecd45acf46d1048212d358b"
      },
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "428-429",
       "sha": "6a05a3f6f6276ea1c288e85a68f044cdac64ce317b533deecf989bebb9dec091"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "00000000 is the lowest frequency and 11111111 the highest.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "430-431",
       "sha": "bf8f018e2a06350f1da6412222186a2415db65240e1e6f7f2cb57f6e3574073b"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Six generators each select one of eight octaves and one of 256 tones, over 31 Hz to 7,81 kHz.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "133-134",
       "sha": "d08c4e659ab87b8ed9909ae38facf6027a4d292ad62cd172b12c98bbae8f0978"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Each frequency generator has an enable bit and the generators may be synchronised by the frequency reset bit.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "135-137",
       "sha": "a9fa48e65e97ecef567699239d1533dfc1913b464d13411c2c2f240b3c12df00"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "A write to a register 08 to 0D sets that tone's eight frequency bits.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "387-392",
       "sha": "7c5525a3df30add3449c462896b4d3131de045dedecd45acf46d1048212d358b"
      }
     ]
    }
   ],
