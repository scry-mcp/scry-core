  {
   "key": "0x08..0x0D",
   "name": "frequency",
   "aliases": [
    "tone frequency",
    "Fn"
   ],
   "regions": [
    {
     "ref": "datasheet:SAA1099.raw.txt",
     "lines": "387-392"
    },
    {
     "ref": "datasheet:SAA1099.raw.txt",
     "lines": "428-431"
    },
    {
     "ref": "datasheet:SAA1099.raw.txt",
     "lines": "132-137"
