 "entries": [
  {
   "key": "0x10..0x1F",
   "name": "ICW1 initialization",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "427-436"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "ICW1 holds the flags LTIM, ADI, SNGL and IC4.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "427-436",
       "sha": "c2e1e642b6875de9bd4f96e9ccc2be5fee9e664101bb989fc739c013fd09a2ef"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "LTIM = 1 selects level interrupt mode and disables the edge detect logic on the interrupt inputs.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "427-429",
       "sha": "a5e8ceda95976d56f417ac1defee879f0debe94c1124bc78644ac002d612ebb2"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "ADI = 1 sets a call address interval of 4 and ADI = 0 an interval of 8.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "430-431",
       "sha": "4a66acb0fe65eeeb658d8d883c7c08595583945bfcb8cab4f6ecdec50eda619a"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "SNGL = 1 means this is the only 8259A in the system, so no ICW3 will be issued.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "432-434",
       "sha": "356b9cca8d887cbc295969ae295596dba27e4da81f868998b95b58ba44c38e2a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "IC4 = 1 means ICW4 has to be read; if ICW4 is not needed IC4 is set to 0.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "435-436",
       "sha": "8676a584d6b5c901ddf6041783e7f56b5a9a99fe9550dbe0c986e8bd1d94f1af"
      }
     ]
    },
    {
     "n": "201",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "Level triggered mode is not handled: ICW1 with LTIM = 1 only logs a message.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "251",
       "sha": "38c044274b9a32b454c23d30e2acc9b1c3fba4b1032ec19227874620d10bb1b9"
      }
     ]
    },
    {
     "n": "202",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "The 4-byte call interval is not handled: ICW1 with ADI = 1 only logs a message.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "250",
       "sha": "40dd86e5313713c9bf948968206d1a67e6184757765041de1be9021f03fe32eb"
      }
     ]
    },
    {
     "n": "203",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The 8080 and 8085 call address bits of ICW1 are not handled: a non-zero value only logs a message.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "252",
       "sha": "ffe5f08b894dc68d8a1e73a69bab976dd91cb531aeaacf06d895ee54f3c5d621"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "ICW1 stores its bits 7 to 5 as the low part of the vector address and makes the next write to port 0x01 an ICW2.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "252-253",
       "sha": "39eb7116a2f20eeee946e08b2953f88d08f40623d52f747944d3accf1868f002"
      },
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "334-345",
       "sha": "cd3efb2d7e6727966e74d428d75a8f60e1bb0bac79fb8933553bda4ae1b5bf44"
      }
     ]
    }
   ],
   "closed": [
