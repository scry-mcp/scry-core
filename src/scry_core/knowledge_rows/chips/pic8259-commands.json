   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The special mask mode is cleared by an OCW3 with ESMM = 1 and SMM = 0.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "669-670",
       "sha": "590a35b4720a63b6796f10aeeaba435d97ae1fe19b3e6fe62caf5feb9cd662c3"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "OCW3 with ESMM = 1 and SMM = 0 returns the 8259A to normal mask mode.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "669-670",
       "sha": "590a35b4720a63b6796f10aeeaba435d97ae1fe19b3e6fe62caf5feb9cd662c3"
