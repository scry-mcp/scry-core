  {
   "key": "0x60..0x67",
   "name": "specific EOI",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "574-581"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A specific EOI names in the command the in-service level to reset, for modes that may disturb the fully nested structure.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "574-579",
       "sha": "365915d41cd4533e68d907343d0d7429eab5d39dc04d4d523fe4cccf9d840050"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A specific EOI is OCW2 with EOI = 1, SL = 1, R = 0 and L0-L2 the binary level of the in-service bit to reset.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "579-581",
       "sha": "ab94f641e79c4fe06c420701e75494c6b5923b665c90054662571ed99d564ef2"
      }
     ]
    }
   ],
