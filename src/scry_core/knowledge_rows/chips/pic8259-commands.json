  {
   "key": "0xA0..0xA7",
   "name": "rotate on non-spec EOI",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "600-608"
    },
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "609-617"
    },
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "618-620"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "In automatic rotation a device that has been serviced receives the lowest priority, for devices of equal priority.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "600-608",
       "sha": "1a8aab907eaa72ca593573bb9397127c6b4e93a1cf16cf16abb157022759418b"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Rotation on non-specific EOI is OCW2 with R = 1, SL = 0 and EOI = 1.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "618-620",
       "sha": "b0347a3d3d91836ec5e60cd8afc8fe87245157869489a0f5fbcd5a31ee120314"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "After clearing the highest in-service bit it advances the priority base by one, not to the level just serviced.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "309-315",
       "sha": "dbe6444c57904a9c833d4fdd3d0a4bd5feb02de90e345566a2ae5396b7f7c8b2"
      }
     ]
    },
    {
     "n": "201",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "The rotate bit is not supported: the command logs a message and acts as a plain non-specific EOI.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "272",
       "sha": "72e6eddd766f5a7f81925bc2b8be7fa1c3f4e8aa09ebff9e04e80760657444c3"
      },
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "279-282",
       "sha": "450973fb6a0c3bc01137b8e4926c6d66ba8dc05c53573c06d99211001fb88d4f"
      }
     ]
    }
   ],
