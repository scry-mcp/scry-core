  {
   "key": "0xE0..0xE7",
   "name": "rotate on specific EOI",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "636-640"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Rotate on specific EOI changes the priorities during an end of interrupt command.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "636-638",
       "sha": "50c916d1aa76774b806c7a98fbf6a39dfe42949d47dbab67cf06f86b921532fd"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Rotate on specific EOI is OCW2 with R = 1, SL = 1, EOI = 1 and L0-L2 the IR level that receives the bottom priority.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "638-640",
       "sha": "22998808c8d8a2b7b4de00edaa3b90c65b5195d8885fc634dc45e8115f851539"
      }
     ]
    },
    {
     "n": "201",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "The rotate bit is not supported: the command logs a message and acts as a plain specific EOI.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "272",
       "sha": "72e6eddd766f5a7f81925bc2b8be7fa1c3f4e8aa09ebff9e04e80760657444c3"
