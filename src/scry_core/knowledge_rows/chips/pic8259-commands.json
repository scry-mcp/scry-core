  {
   "key": "0x68..0x6F",
   "name": "special mask on",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "523-532"
    },
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "648-668"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Special mask mode inhibits further interrupts at a level whose mask bit is set and enables the other unmasked levels, lower or higher.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "661-667",
       "sha": "ca5e7c4369bf516fff11bde57dfd9f915d3e74021b55a36ff57e2b4b0d768cf3"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The special mask mode is set by OCW3.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "668",
       "sha": "870df0e9d127948e2b75235652f4f4bce5db9874b0c74a83ec1deabbc08fab9f"
      }
     ]
    },
    {
     "n": "3",
     "on": "bit 6",
     "of": "doc",
     "text": "ESMM = 1 enables the SMM bit to set or reset the special mask mode; with ESMM = 0 SMM is a don't care.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "524-527",
       "sha": "b1a67e5c67e7e0ac7a748b39b0d106e8177d308da4b1154afd48f9bdeefd2cdf"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "With ESMM = 1 and SMM = 1 the 8259A enters special mask mode; with ESMM = 0 SMM has no effect.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "528-532",
       "sha": "eb07221177a0b155f15089a5c2b766e975916ca5573d873798dbef18b3e03c78"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "The special mask mode lets a service routine enable lower priority requests that an in-service bit would otherwise inhibit.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "649-660",
       "sha": "a3a01243ade0b4a4b54d96dac0c5223e43206d330d665ff3877095c6b45c8407"
      },
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "661-665",
       "sha": "45df4fa7da67c586a360b74fb3f58cdfd18de157d16bb57fd7caf9f719782c39"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "OCW3 with ESMM = 1 and SMM = 1 does not start a special mask mode: a TODO comment marks it as not done.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "270",
       "sha": "fe3ec7b07b8f2d33971878afdea39d4138bba178750ee6fa14cafaa10ed92356"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "4",
     "text": "Special mask mode is not entered: the OCW3 code carries a TODO for it.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "270",
       "sha": "fe3ec7b07b8f2d33971878afdea39d4138bba178750ee6fa14cafaa10ed92356"
      }
     ]
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "The mode enables no request: the OCW3 code carries a TODO for special mask mode.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "270",
       "sha": "fe3ec7b07b8f2d33971878afdea39d4138bba178750ee6fa14cafaa10ed92356"
      }
     ]
    }
   ],
