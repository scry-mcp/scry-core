  {
   "key": "0xC0..0xC7",
   "name": "set priority",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "624-635"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The set priority command fixes the bottom priority device, so all other priorities follow; IR5 at the bottom makes IR6 the highest.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "624-629",
       "sha": "abf8e33e4f2eb56b3ec64bcb4b14c2c48f2f878fd304d2000d31890ded6c6571"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Set priority is OCW2 with R = 1, SL = 1 and L0-L2 the binary priority level code of the bottom priority device.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "630-632",
       "sha": "d23827dd43d201f1a13c3563232dd4247a6afd12673c84149cd5c83b96d585d4"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "In this mode internal status is updated by software during OCW2, independently of the end of interrupt command.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "633-635",
       "sha": "70c27969bd62b4f70d4e2b7d75f664382b5c3d7810eb8862aa267d4d864959a4"
      }
     ]
    },
    {
     "n": "201",
     "on": "write",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "2",
     "text": "The set priority command is not handled: it only logs a message and the priority is unchanged.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "291-293",
       "sha": "1fd00bcfe1855e897e7a8c2fc5902d47a25fa62bc1dc118bcb094f29387835d3"
      }
     ]
    },
    {
     "n": "202",
     "on": "when",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "3",
     "text": "No priority is set by the command, so internal status stays as it was.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "291-293",
       "sha": "1fd00bcfe1855e897e7a8c2fc5902d47a25fa62bc1dc118bcb094f29387835d3"
      }
     ]
    }
   ],
