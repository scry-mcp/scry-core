  {
   "key": "0x80..0x87",
   "name": "set rotate in AEOI",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "621"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Rotate in automatic EOI mode is a mode that OCW2 sets.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "621",
       "sha": "64cb5ab4c54f6f4a08a197a153f001754de94992cd2a66822956fbfc1f861488"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Rotate in automatic EOI mode is set by OCW2 with R = 1.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "621",
       "sha": "64cb5ab4c54f6f4a08a197a153f001754de94992cd2a66822956fbfc1f861488"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "The command rotates the priority once by one level instead of setting a rotate in automatic EOI mode.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "306",
       "sha": "3385ba1ef47b75841aed17febcbb388f69e8d12c335746514dcbbc2219ed1af1"
      }
     ]
    }
   ],
