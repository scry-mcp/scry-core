  {
   "key": "0x00..0x07",
   "name": "clear rotate in AEOI",
   "regions": [
    {
     "ref": "datasheet:8259A.raw.txt",
     "lines": "622-623"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Rotate in automatic EOI mode is cleared by a command.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "622-623",
       "sha": "76ed114e53761dca1b500e514682f56a2f4fbe229e5a2628f9e3d1b7d529d626"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Rotate in automatic EOI mode is cleared by OCW2 with R = 0, SL = 0 and EOI = 0.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "622-623",
       "sha": "76ed114e53761dca1b500e514682f56a2f4fbe229e5a2628f9e3d1b7d529d626"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "The command resets the priority base to IR0 instead of clearing a rotate mode.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "285",
       "sha": "42c96a66bd8029598e4b9ba233f7fe61e51d155179c9e67d2797fed335cf7ac6"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/pic.cpp",
     "lines": "288-290",
     "as": "agrees",
     "row": "2"
    },
