   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The CS, WR, RD and A0 signals control the reading and writing of the register addresses and data of the OPLII.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "163-165",
       "sha": "92b2863b03c7365b1c441896267e4bd8dfcc6820f65b3a643d4882bb3ebbb7b2"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "In address write mode the address of the designated internal register is set, after which data can be written.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "180-182",
       "sha": "25a44b9062fa3e10a42b4997be5f4e0e0903d282cd9bc4c4bcc5a38a477499f0"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "In data write mode the data bus is written to the register having the designated address.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "185-186",
       "sha": "cc225bc74f5a2535cfda71098909a61326cbfaa65ed83c56458d1e3b11fdb253"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "In status read mode the contents of the status register are output on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "190-191",
       "sha": "0d4d84ce4629c0c49c5e048f78a2b1ce5c4639a9432a2912b829c7070f3a4e10"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "In inhibit mode the data on the bus is meaningless and cannot be controlled.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "193-195",
       "sha": "84f499b0495ec7c5d6018174425110efcc647803ec9bf98f8ccac7f35fe8758e"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The registers are an area of 777 bits, addressed by subaddresses; the capture reads the bit count as 777.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "276-278",
       "sha": "fbc2d003ae31f0e98632ab352e6ddbe5583a8cf6ad50dc09817205667efa255f"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Data is stored by sending the subaddress first and then the music data; repeated access to one subaddress needs no new address.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "278-281",
       "sha": "245533f04014728198b566d5abaa700c5d40942613b829a3563430ff84b1e263"
      }
     ]
    },
    {
     "n": "8",
     "on": "reset",
     "of": "doc",
     "text": "The initial setting of all registers is 0, an initial clear; the capture shows the 0 as Q.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "282",
       "sha": "8e0e9653e1bcccf276ea5c4c77e3a8a56121760bb45d7e412f9fa62a96384cf2"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "The timers set flags after a set period, read as status or as interrupt signals; the interrupt signal is open drain.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "731-734",
       "sha": "7dd75e64462652f3afdb8351fb1bd1b2a01e9e96f2c82d119028644c9b3cc337"
      }
     ]
    },
    {
     "n": "10",
     "on": "when",
     "of": "doc",
     "text": "Status bit D5 is the timer 2 flag, set to 1 when timer 2 reaches its set time; the capture reads the bit as Ds.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "736",
       "sha": "d5e22535f884845c01644723b571553122f8ea66fae229ebf3fce948a8ce1285"
      }
     ]
    },
    {
     "n": "11",
     "on": "is",
     "of": "doc",
     "text": "The timer 2 flag remains set until reset.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "737",
       "sha": "526373f863d49325872b31e4bb81052a9ba7368e81071d4e8635434b6ca00286"
      }
     ]
    },
    {
     "n": "12",
     "on": "when",
     "of": "doc",
     "text": "Status bit D6 is the timer 1 flag and works like D5; the capture reads the bit as De.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "738",
       "sha": "da22dabb081c150c7d0ee7677eb17d2cb768597b9785458c65a9684479ef6700"
      }
     ]
    },
    {
     "n": "13",
     "on": "when",
     "of": "doc",
     "text": "Status bit D7 (IRQ) is set to 1 when D5 or D6 is 1.",
     "quotes": [
      {
       "ref": "datasheet:YM3812.raw.txt",
       "lines": "739",
       "sha": "059e799848ada51c035127b280b3d65243b6c5cc18774912fc65a2139a6a5681"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "A status read also sets bits 1 and 2 of the byte, 0x06.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1151",
       "sha": "915e21ff7b9e211b27fda660b8d8aea96f8a161806ff0a31770ad3ec8ebfb337"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A status read also sets bits 1 and 2 of the byte, 0x06, in OPL2 mode.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/adlib.cpp",
       "lines": "1349-1350",
       "sha": "d633f1cb56e19582e3afa1e0ba067541fc310d3d003881d0e90bb264b2a517d4"
      }
     ]
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "A read at the second port offset returns 0xFF instead of undefined data.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1161",
       "sha": "91da7a6fbff27949398740298341cd6fc962f344176fffcdbe05c92d2c3efc3f"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1168-1169",
       "sha": "97b410a8e94eb1ae51e88f49da14d6d5623e350af71b7ac92bde933abf7fb767"
      }
     ],
     "row": "5"
    },
    {
     "n": "104",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "A read at a port whose two low bits are not 00 returns 0xFF instead of undefined data.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/adlib.cpp",
       "lines": "1346-1353",
       "sha": "ca9d8f8a153f8e5964f02ab0b150af1314762393619e123613bff082249146c1"
      }
     ],
     "row": "5"
    },
    {
     "n": "105",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 16-entry frequency multiple table, stored doubled, holds 0.5, then 1 to 10, then 10, 12, 12, 15 and 15.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "117-120",
       "sha": "60d8963fd8ee7e3f8e002da3bbb06266340d438d2f799f535f37323df60b7034"
      }
     ]
    },
    {
     "n": "106",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 13-entry attack table holds the sample counts 69, 55, 46, 40, 35, 29, 23, 20, 19, 15, 11, 10 and 9; its comment leaves out the highest attack rate.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "123-129",
       "sha": "4c69953c15c06aa64d6497190078827a38711a432bfe68c015c7fbb4826fda56"
      }
     ]
    },
    {
     "n": "107",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 13-entry envelope increase table holds 4 to 8, 10, 12, 14, 16, 20, 24, 28 and 32; its comment says a real OPL takes 8 samples to reach them.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "130-136",
       "sha": "4943afd1ce50754df1c4c4eac0ad1b889046396310d815d588e6a8e97050bad4"
      }
     ]
    }
   ],
