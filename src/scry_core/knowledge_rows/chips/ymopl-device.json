   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The LSI is controlled by writing registers and reading status through an 8-bit parallel CPU interface, with D0 to D7 as the data bus.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "150-153",
       "sha": "629f50677b34d440d1d7a03ecba46f73f614642f5b5f5a60960a712d032a29e7"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The /CS, /RD, /WR, A0 and A1 levels select inactive, address write, data write or status read mode.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "154-160",
       "sha": "5c5b4c9bb0ad8636077e3cde9733e0992d7b7ed86d46bd02416475a2417df71c"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "Operation in states other than the listed access modes is not guaranteed.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "161",
       "sha": "921e0c4f780a49ef9fd718b2d791bf0891e43bc641ab076536b841297a638743"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "In address write mode the address is output on the data bus; A1 low selects register array 0 and A1 high selects register array 1.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "164-166",
       "sha": "973b3f21d74871cad6e77999412e61d116eeb775e1b41ecfaf8f5cdb2497ad2a"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "After an address write, data may be written in data write mode after a minimum of 32 master clock cycles.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "166-167",
       "sha": "a223c384cab0b4aac500cc65941ace3eb98074fd5f41607964879fdc59fd37d9"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "In data write mode the data on the data bus is written at the address specified previously.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "169-170",
       "sha": "1d411d5bac9d77904605bf8818aac82dc8553eae70c75734936706a491af5986"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "A wait of at least 32 master clock cycles is required before the next address write or data write.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "170-171",
       "sha": "fa9d1708098179557804de2e99ed4876fa50eaebf9f19e7c8cadff77343c6605"
      }
     ]
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "In status read mode the status of the LSI is output on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "172-173",
       "sha": "692b6aa7faed5c1c4a531e0118e639161a93968cd19dc113fcffaa331213c6c9"
      }
     ]
    },
    {
     "n": "9",
     "on": "reset",
     "of": "doc",
     "text": "All registers are cleared at reset.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "315",
       "sha": "a710822e27fcc5560fd1e655c0c44dacba3d5ab9c407fece2d78c22bd4f75b63"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "The status register holds the bits IRQ, FT1 and FT2.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "645-646",
       "sha": "7d4127db4b1080d883ef4a4afd34ef9bc43971fb168803edeb699d832eb9b4e9"
      }
     ]
    },
    {
     "n": "11",
     "on": "when",
     "of": "doc",
     "text": "FT1, the timer 1 overflow flag, is set to 1 when timer 1 overflows.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "647-648",
       "sha": "5229826fde1c66d5998ba813d04e5adb13c8c9f5b432080f3d7ebfebae606bb7"
      }
     ]
    },
    {
     "n": "12",
     "on": "is",
     "of": "doc",
     "text": "FT1 is not reset unless RST is written.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "649",
       "sha": "25e468dc758bb4e7d83e21064799cf2e61c76126e3270b22670602b4017013eb"
      }
     ]
    },
    {
     "n": "13",
     "on": "when",
     "of": "doc",
     "text": "FT2, the timer 2 overflow flag, is set to 1 when timer 2 overflows.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "650-651",
       "sha": "1271a2cfb99340bca759ba44955a30118a9d3853e659759cc6759eb5e918a111"
      }
     ]
    },
    {
     "n": "14",
     "on": "is",
     "of": "doc",
     "text": "FT2 is not reset unless RST is written.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "652",
       "sha": "25e468dc758bb4e7d83e21064799cf2e61c76126e3270b22670602b4017013eb"
      }
     ]
    },
    {
     "n": "15",
     "on": "when",
     "of": "doc",
     "text": "IRQ is set to 1 if FT1 or FT2 is set.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "653-654",
       "sha": "eb5d0a48637feca7dd068e4b8fcab620fe5a2539ecbdd556f5ed22bcee5c546c"
      }
     ]
    },
    {
     "n": "16",
     "on": "is",
     "of": "doc",
     "text": "IRQ is not reset unless RST is written.",
     "quotes": [
      {
       "ref": "datasheet:YMF262.raw.txt",
       "lines": "654",
       "sha": "56b80310d9e02c8355738f869952af485f3158b7c853d5e23f66c792136af020"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "Port 0 stores the address as documented, but write_address_hi sets address bit 8 and masks it off again while NEW is 0, except for register 0x105.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1331",
       "sha": "a73fee75a057ed1d989573cf80fe03ea577dc0c1f215d82931a1591f273f2497"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1363-1368",
       "sha": "768dc1dc5f933bce0d6d9632fa5305c69f739d627bcd1792b3532d84677870cb"
      }
     ],
     "row": "4"
    },
    {
     "n": "102",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "A port 0 write returns the address as is, but a port 2 write gets bit 8 only when OPL3 mode is active or the address is 0x05.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "1192-1198",
       "sha": "44aa587ffe119afae622f8e4ed08b198f4bec2198a618a107e8b319cacff0d61"
      },
      {
       "ref": "dosbox-x:src/hardware/adlib.cpp",
       "lines": "1320",
       "sha": "1abd000556062007dc22931e16109f1a324ab57dba61a622218cc1330557b416"
      }
     ],
     "row": "4"
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "A read at offsets 1 to 3 logs it and returns 0xFF.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1302",
       "sha": "91da7a6fbff27949398740298341cd6fc962f344176fffcdbe05c92d2c3efc3f"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1309-1313",
       "sha": "f8b94efdcc7e88ae5b5f864124b6152140f7b87dc7f5c49699fc40ebfe8a418a"
      }
     ],
     "row": "3"
    },
    {
     "n": "104",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "A read at a port other than the first returns 0xFF in OPL3 mode.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/adlib.cpp",
       "lines": "1363-1369",
       "sha": "759be1e7717a610b018006617d8365553dd7d4b7ab71baab15875952b039cdfe"
      }
     ],
     "row": "3"
    },
    {
     "n": "105",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 16-entry frequency multiple table, stored doubled, holds 0.5, then 1 to 10, then 10, 12, 12, 15 and 15.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "117-120",
       "sha": "60d8963fd8ee7e3f8e002da3bbb06266340d438d2f799f535f37323df60b7034"
      }
     ]
    },
    {
     "n": "106",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 13-entry attack table holds the sample counts 69, 55, 46, 40, 35, 29, 23, 20, 19, 15, 11, 10 and 9; its comment leaves out the highest attack rate.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "123-129",
       "sha": "4c69953c15c06aa64d6497190078827a38711a432bfe68c015c7fbb4826fda56"
      }
     ]
    },
    {
     "n": "107",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "DOSBox-X's 13-entry envelope increase table holds 4 to 8, 10, 12, 14, 16, 20, 24, 28 and 32; its comment says a real OPL takes 8 samples to reach them.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/dbopl.cpp",
       "lines": "130-136",
       "sha": "4943afd1ce50754df1c4c4eac0ad1b889046396310d815d588e6a8e97050bad4"
      }
     ]
    }
   ],
