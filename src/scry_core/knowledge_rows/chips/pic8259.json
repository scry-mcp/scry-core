     "function": "read_command"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A read returns the IRR or the ISR, as chosen by OCW3, or the word enabled onto the data bus during RD.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "696-698",
       "sha": "4786998af9b73314bd8853c9a0483b9a4e2998cbc755b82f365093b4c6d64d87"
      },
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "709-710",
       "sha": "47ac5feccac26c687f7bd0e5bd7b705696591e779d39870156ee3d979188ce9c"
      },
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "685-686",
       "sha": "f23dbbffeb2ffcfe77b8edeab218c35bf7fa98e15843414e9e37718e63f89167"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "The IRR holds the levels requesting an interrupt; the highest request is reset when acknowledged, and the IMR does not affect it.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "711-715",
       "sha": "9fa5ce4dd40d81294fec46596f53e6453ccd2872a1843c88ad839b7029ca4841"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The ISR holds the priority levels being serviced and is updated when an end of interrupt command is issued.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "716-719",
       "sha": "0ba84cc7ad727f007611062bf7aa04ebe8abec2ce393f43e4efff1b909d72d0b"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "The 8259A remembers whether OCW3 chose the IRR or the ISR, so no OCW3 is needed before each read, except with poll.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "728-733",
       "sha": "e500adb1b6cc159c91412ed79bf022c04c07ced699167b88daebfba7a595c819"
      }
     ]
    },
    {
     "n": "5",
     "on": "reset",
     "of": "doc",
     "text": "After initialization the 8259A is set to read the IRR.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "734",
       "sha": "961dd182ce6371886721996524e933c7e599c178d024b504780b355e979814b3"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "A poll overrides a status read when P = 1 and RR = 1 in OCW3.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "738-739",
       "sha": "90ceafeb1f6d0af7c8c85780ec31bbed6346d66aa1e02e9df3aa66625fe7c748"
      }
     ]
    },
    {
     "n": "7",
     "on": "read",
     "of": "doc",
     "text": "The word enabled onto the data bus during RD holds I in bit 7 and the binary code W2 W1 W0 of the highest requesting level in bits 2-0.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "685-690",
       "sha": "8d71ac6d27085a7e14c6b0ec62e7da95347cfcf2bd14f89701899bdd64b5f4f1"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "differs",
     "row": "3",
     "text": "The ISR read returns the in-service bits with the masked ones removed.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "221",
       "sha": "85ef29b11656f5f6cbdd8298da90f2de2a6bf407d8b24fe1acf029182924201e"
      }
     ]
    },
    {
     "n": "102",
     "on": "reset",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "ICW1 leaves the OCW3 register selection alone, so a read after it returns what was selected before.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "245-256",
       "sha": "ea74390b1d609d3260a497e41898b55a9dcb970e4f441bb5d27dcc01fe2f618e"
      }
     ]
    },
    {
     "n": "201",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "5",
     "text": "ICW1 does not reset the register selection, so a read after it returns what was selected before.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "249-256",
       "sha": "60da514da6ca74abedbf2a3aff60a7ae57a4755dfb8563610247d0fb3a7ed383"
      }
     ]
    },
    {
     "n": "202",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "6",
     "text": "Poll is not handled: OCW3 with P = 1 only logs a message, so a read returns the selected register.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "258",
       "sha": "36fef93f7067a184ceb4f8949a6ab06fa3fd6d895a5c0aa243d4ba4bdce4ffac"
      },
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "344-345",
       "sha": "73a83d9095ab3d63f2c6ffea35e2c1599a84165d761b11651c550f31bdd78865"
      }
     ]
    },
    {
     "n": "203",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "7",
     "text": "A read after a poll command returns the selected register, not the poll word.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "258",
       "sha": "36fef93f7067a184ceb4f8949a6ab06fa3fd6d895a5c0aa243d4ba4bdce4ffac"
      },
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "344-345",
       "sha": "73a83d9095ab3d63f2c6ffea35e2c1599a84165d761b11651c550f31bdd78865"
      }
     ]
    },
    {
     "n": "204",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "Reading the IRR of the master first brings the timer interrupt line up to date.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/pic.cpp",
       "lines": "349-351",
       "sha": "2253392f19592a12b61e53077cdfaef648cee2797b2cd2998dcaee0e76aff901"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A poll read that finds a level clears its request bit unless level triggered or a slave sits on it, and sets its in-service bit unless auto EOI.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "198-208",
       "sha": "1bb55c6183a5931a5b640d08293d341f64516f0f81dd7927efa4ebbd869d5420"
      }
     ]
    },
    {
     "n": "104",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A poll read clears the poll bit of the stored OCW3 when side effects are enabled.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "191",
       "sha": "c059df8a3453062eb996a88b9837e0e57a4fe025911dd0983a1370ed78c3e042"
      },
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "210-211",
       "sha": "be3cec0d5e06b12c1b52149b7f07f1b9414e31be24c6d5ca782dd636dff83464"
      }
     ]
    },
    {
     "n": "105",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "text": "A poll read is chosen by the P bit alone: the test is m_ocw3 & 0x04, with no test of the RR bit.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "191",
       "sha": "c059df8a3453062eb996a88b9837e0e57a4fe025911dd0983a1370ed78c3e042"
      }
     ],
     "row": "6"
    }
   ],
