   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A write with A0 = 0 is ICW1, OCW2 or OCW3, told apart by bits D4 and D3.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "383-385",
       "sha": "30a33f8d33a5b055b48c839112178c3a54109066925684a520fe9777b417bd25"
      },
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "500-503",
       "sha": "de8a5f0982d3e84cd8a45a3fc9b04dc14ea64badb99d10807bdff83858c8df24"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A command issued with A0 = 0 and D4 = 1 is interpreted as ICW1.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "383-385",
       "sha": "30a33f8d33a5b055b48c839112178c3a54109066925684a520fe9777b417bd25"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "OCW2 is written with A0 = 0 as 0 R SL EOI 0 0 L2 L1 L0.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "500-501",
       "sha": "2072ba616db3e6eafb6f0996450bb266e01f25c52cfc28c942eb7032592304f6"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "OCW3 is written with A0 = 0 as 0 0 ESMM SMM 0 1 P RR RIS.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "502-503",
       "sha": "9ec38b9dfe1c140b7e882207ca67f4e261cea4f36cb8bbd5569fc29e0e11ff40"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "OCW2 and OCW3 are decoded only once the initialization sequence has finished and the state is READY.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "259",
       "sha": "cd115ad5604f1244393990ad8b80e1b5ee65c9a21f080892d3e3e8e790fb3a45"
      }
     ]
    }
   ],
