   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The IMR holds the interrupt request lines that are masked.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "720-721",
       "sha": "ec1deec463253d0cdd7ac4d2b18b5fdccde5a2a133fad47903d77b810500bbb5"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Reading the IMR needs no OCW3: the data bus holds the IMR whenever RD is active and A0 = 1.",
     "quotes": [
      {
       "ref": "datasheet:8259A.raw.txt",
       "lines": "735-737",
       "sha": "1de6eda4c03e73aa0a3a48d1bb6def67c0025b9453cea8a5c56ff7cc8c70b66a"
      }
     ]
    },
    {
     "n": "3",
     "on": "reset",
     "of": "mame",
     "vs": "extra",
     "text": "The device reset stores 0 in the mask register.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/pic8259.cpp",
       "lines": "437",
       "sha": "7ec67c0df204c8f00c01f8f6045afbba80864df76f1910fb5b436701130aefcd"
      }
     ]
    },
    {
     "n": "4",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The controller reset stores 0xFF in the mask register.",
