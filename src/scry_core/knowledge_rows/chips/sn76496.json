   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 1 is the destination control register Tone 1 Attenuation.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "306",
       "sha": "fcc1979f9e6ffef0e306950e319ceb9acff4b5011ba842bbeb17a9ad8775a5a9"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "A four-stage attenuator sets the output level; its control bits may be true together, giving up to 30 dB.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "188-190",
       "sha": "af04dbdbdece41d7410cfdf2c2d127a1ffb16c1ee33edc21e1a5a83c6ec5b12d"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The weights of A0, A1, A2 and A3 are 16, 8, 4 and 2 dB, and all four bits set is off.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "197-204",
       "sha": "d763c3fc0ffee31a95d47886e27dc0ebb7d21509f5505cc5af20aee14ddff4a2"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A single byte sets the attenuation from its low four bits; the printed data field is garbled in the capture.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "322-325",
       "sha": "c657e6efa948c54a42e828a73ec2cbc10554db08cdb89289d9e98a216af05d07"
      }
     ]
    }
   ],
