   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 6 is the destination control register Noise Control.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "311",
       "sha": "5e4e97acd4d0e4efd8dc84b92b06e7848fc7c37e5b6f8c60c956a202ddd5742b"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The noise source is a shift register with an exclusive-OR feedback network, guarded against the zero state.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "206-208",
       "sha": "5b0556a2ca7067e99022cb9608f375e1947610f3472d783282108248bfba0360"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "FB selects periodic noise when 0 and white noise when 1.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "209-212",
       "sha": "a324fa7651a8bcf3a9d1a77237d37e0b4fc56c74ff279dedce98ebff0aac123e"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "A change of the noise control register clears the shift register; NF0 and NF1 choose one of four shift rates from the clock.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "213-214",
       "sha": "b9f972a7270a273d216668c85eabfb40fc57cc68a2718834f354ab80f37d5482"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The shift rates are N/64, N/128, N/256 and the tone generator 3 output.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "215-221",
       "sha": "f9991c38a633304dfa832577554468ce189586e2b90d9189f88f7428d7f2e9bb"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The noise source's output passes through a programmable attenuator.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "222",
       "sha": "9dec1fabe8efed9d289668b5c917187322e8a7ceaeb7bb47c6edc5a2ae9afc80"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "doc",
     "text": "A single byte sets the noise control from its low bits; the printed field is partly garbled in the capture.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "318-321",
       "sha": "8c4666d29af4adbe57198eea2fc3e748ea4f6c2d2f2c21ddf8ed250ebbb78e66"
      }
     ]
    }
   ],
