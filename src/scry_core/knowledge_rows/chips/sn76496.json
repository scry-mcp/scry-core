   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 0 is the destination control register Tone 1 Frequency.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "305",
       "sha": "199c0841093ad8f822c9657bf051713cad8257b57518d1d5533647a46755d3db"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "A tone needs ten bits, F0 to F9 with F0 the most significant, in a ten-stage counter counting down at N/2.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "177-180",
       "sha": "2321e7a814ed3afd42944ae130fdefc52cd8fbc9fe15f0283b322b7892771b4c"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The counter's borrow toggles the output and reloads the counter, so the period is twice the register value.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "180-182",
       "sha": "ceef07c4be0c56a873e435b980030e11877872c513621bca53ffed6db6d1db0f"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The document gives the frequency as a formula in the clock N and the number n; the formula is garbled in the capture.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "183-187",
       "sha": "89c87d40d3d74fbea7ba7c5a56f68cc4c4e0aafc488e43eabe01921ee9e2f73d"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The chip has eight control registers and the first byte of a transfer carries a three-bit address field.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "298-301",
       "sha": "603f2df575aeeba23668739f774135dd5409027bf25d54901b9780ab9cb83b27"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "A frequency selection is a double-byte transfer while an attenuator selection is a single byte.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "292-293",
       "sha": "bda239056a9ec319c3c37811a5c978a51a1f3197b24818824bc6290ee11eaf21"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "With the address latched, later second bytes alone change the six most significant bits.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "294-297",
       "sha": "ec07f38e84ce826f3c016789bb1c3e0dcfdeaba04cdd7297e78e201f750dc5ec"
      }
     ]
    },
    {
     "n": "8",
     "on": "write",
     "of": "doc",
     "text": "A frequency takes two bytes: the first its address field and D3-D0, the second the six upper data bits; the field labels are garbled.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "313-317",
       "sha": "9bde9646db1cd6279642ccc2d7666495805354d287371fe6edc4f142bd00d951"
      }
     ]
    }
   ],
