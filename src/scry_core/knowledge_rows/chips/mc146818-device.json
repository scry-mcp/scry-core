   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The MC146818A combines a time-of-day clock with alarm and a one hundred year calendar, a programmable periodic interrupt and square-wave generator, and 50 bytes of static RAM.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "4-11",
       "sha": "d9e4e2ea35c4e73e1e4d2725abdc3bd2e6da6678f67e256cfda1752fe6d3bb97"
      }
     ]
    },
    {
     "n": "2",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Periodic Interrupt Enable bit is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "480-482",
       "sha": "11187937e3c8a3d14d311f6f0d177aae57524c9578fdc6dfec36c75c87e9a2f7"
      }
     ]
    },
    {
     "n": "3",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Alarm Interrupt Enable bit is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "483",
       "sha": "88ab1d08fcf7de0261d60607dd864ca3c136bb3331d20fd42c79313d1b1ce4b8"
      }
     ]
    },
    {
     "n": "4",
     "on": "reset",
     "of": "doc",
     "text": "Item c) of the RESET list, which the capture repeats as Alarm Interrupt Enable, is cleared to zero when RESET is low.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "484",
       "sha": "8b9e0fb6fe43fe5ee2f1f35645ffdf11a189314e85410dae434193dd599effa7"
      }
     ]
    },
    {
     "n": "5",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Update ended Interrupt Flag is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "485",
       "sha": "da4f10220425f3f7e1fba7a1f0411ed03c5606e241539847197136c6e418b7d3"
      }
     ]
    },
    {
     "n": "6",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Interrupt Request status Flag is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "486-487",
       "sha": "e285ac04def056eb4900d8174172640e67f70019e5006445f482068158c07b2c"
      }
     ]
    },
    {
     "n": "7",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Periodic Interrupt Flag is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "488",
       "sha": "ef60b326af19c2154ff7d51bec253b94bcd49bd93bdf926cadb47a1dbc7fc9ff"
      }
     ]
    },
    {
     "n": "8",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Alarm Interrupt Flag is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "490",
       "sha": "1f9f9f9898e3e6d9014e3445f79d1542c04d024f3c70010a29000e5460612802"
      }
     ]
    },
    {
     "n": "9",
     "on": "reset",
     "of": "doc",
     "text": "When RESET is low the Square Wave output Enable bit is cleared to zero.",
     "quotes": [
      {
       "ref": "datasheet:MC146818A.raw.txt",
       "lines": "492-493",
       "sha": "22d678ff43a006f42f1c7ed45d092e2987ab056a4e01d2255222f423f3c65a90"
      }
     ]
    },
    {
     "n": "201",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "Reset also writes register 0x0A with 0x26 through cmos_writereg.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/cmos.cpp",
