       "sha": "5fae996c0d2684b2fa72a390f360c796bfbbb80ec3cf838c8f736241bceb2344"
      }
     ]
    },
    {
     "n": "202",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "Reset sets register 0x0D to 0x80 and stores base and extended memory sizes in the CMOS RAM.",
