      "key": "0x08",
      "name": "status",
      "aliases": [
        "DMA status"
      ],
      "description": "Status register, read: which channels reached terminal count and which have a request pending.",
      "behaviour": "Bits 0 to 3 are set when a channel reaches terminal count and are cleared by the read; bits 4 to 7 are set while a channel's request is pending. MAME inverts bits 4 to 7 when the command register makes DREQ active low.",
      "access": "read",
      "sources": [
        {
          "role": "documentation",
          "ref": "datasheet:Intel 8237A datasheet, https://pdos.csail.mit.edu/6.828/2005/readings/hardware/8237A.pdf, Status Register",
          "cites": "Reset and on each Status Read. Bits 4–7 are set"
