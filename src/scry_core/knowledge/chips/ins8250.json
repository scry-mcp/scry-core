    {
      "key": "0x01",
      "name": "interrupt enable",
      "aliases": [
        "IER",
        "DLM"
      ],
      "description": "Interrupt enable register, or the high byte of the baud rate divisor when the divisor latch bit is set.",
      "behaviour": "With the divisor latch bit clear, bits 0 to 3 enable the received-data, transmitter-empty, line-status and modem-status interrupts, and a read returns only those four bits. With it set, the register is the high byte of the baud rate divisor.",
