    {
      "key": "0x02",
      "name": "interrupt id, FIFO ctl",
      "aliases": [
        "IIR",
        "FCR"
      ],
      "description": "Interrupt identification register on a read, FIFO control register on a write.",
      "behaviour": "A read returns the identification register: bit 0 clear means an interrupt is pending and bits 3 to 1 say which. A write sets FIFO control on the 16550 only (bit 0 enable, bit 1 clear receive, bit 2 clear transmit, bits 7 and 6 the trigger of 1, 4, 8 or 14 bytes); the 8250 and 16450 ignore it.",
      "differs": "DOSBox-X has one FIFO control write for every UART type; in MAME only the 16550's takes effect.",
      "sources": [
