    {
      "key": "0x0D",
      "name": "status D",
      "aliases": [
        "register D"
      ],
      "description": "Status register D, read only: whether the clock's battery kept its RAM valid.",
      "behaviour": "Bit 7 set means the battery kept the RAM and the time valid; bits 6 to 0 read 0. The chip's register is read only.",
      "differs": "DOSBox-X holds bit 7 from the start, returns it unchanged on a read and keeps bit 7 of a write; MAME sets it only after a read (unless its RAM was loaded) and ignores a write.",
      "sources": [
        {
